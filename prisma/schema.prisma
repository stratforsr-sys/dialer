generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  // Database migrated to support Deal pipeline (Apr 2026)
}

// ==================== USERS ====================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SELLER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads        Lead[]         @relation("LeadOwner")
  activities   Activity[]     @relation("ActivityActor")
  callSessions CallSession[]
  dealsCreated Deal[]         @relation("DealCreatedBy")
  listsCreated CallList[]     @relation("ListCreatedBy")
  listAccess   ListAccess[]

  callAttempts CallAttempt[]    @relation("CallAttemptSeller")
  scripts      ScriptTemplate[] @relation("ScriptAuthor")
  dncAdded     DoNotCall[]      @relation("DncAddedBy")
  presence     SellerPresence?
  callbacks    Callback[]       @relation("CallbackSeller")

  telephonyAgents TelephonyAgent[]
  telephonyCalls  TelephonyCall[]
}

enum Role {
  ADMIN
  SELLER
}

// ==================== LEADS & CONTACTS ====================

model Lead {
  id            String   @id @default(cuid())
  companyName   String
  orgNumber     String?  @unique
  website       String?
  address       String?
  /// Ort. Egen kolumn i stället för sista ledet i address — manusets {ort}
  /// läste tidigare ut den med en split på komma, vilket gav "12345 Göteborg"
  /// eller hela adressen beroende på hur exportfilen råkade se ut.
  city          String?
  /// Kvalificeringsdata från importfilen. Båda är nullbara med flit: noll
  /// anställda och "vet ej" är olika saker, och en tom kolumn får aldrig bli
  /// en nolla som sedan sorteras som om den vore mätt.
  /// Läsbar bransch — det säljaren ser. Antingen filens egen branschtext eller
  /// en etikett härledd ur SNI-kodens huvudgrupp. Denormaliserad hit och inte
  /// uträknad vid läsning: cockpiten ska hämta den med samma select som allt
  /// annat, utan uppslag per lead.
  industry      String?
  /// Rå SNI-kod från källan. Sparas separat eftersom etiketten är en tolkning
  /// och tolkningar ska gå att göra om utan att originalet är borta.
  industryCode  String?
  /// Var branschen kom ifrån: "import", "website", "name", "manual".
  /// Avgörande för att kunna köra om klassificeringen selektivt — en gissning
  /// från bolagsnamnet ska gå att ersätta när sajten dyker upp, medan en
  /// handsatt bransch aldrig får skrivas över av en modell.
  industrySource String?
  /// 0–100. Under tröskeln sparas ingenting alls: fel bransch på skärmen är
  /// värre än tom, eftersom säljaren öppnar samtalet med den.
  industryConfidence Int?
  employees     Int?
  /// Lagras exakt som talet stod i filen — ingen enhetsomräkning. Exporterna
  /// blandar kronor och tkr och det går inte att gissa vilket utan att fråga.
  revenue       Float?
  /// När bolaget registrerades, enligt importfilen. Lagras som datum utan tid
  /// i UTC — registreringsdatum har ingen klockslagsprecision, och en tid hade
  /// gjort "samma dag" beroende av var läsaren sitter. Ett år utan månad och
  /// dag landar på 1 januari; frågan kolumnen ska svara på är hur gammalt
  /// bolaget är.
  registeredAt  DateTime?
  hasActiveDeal Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Claim-lås: ownerId pekar på den som just nu jobbar leadet.
  // claimedAt = null → leadet är fritt (ownerId är bara importören).
  // claimedAt äldre än CLAIM_TTL_DAYS → låset har löpt ut, leadet är fritt igen.
  claimedAt DateTime?

  // ── Uppföljningsmotorn ────────────────────────────────────────────────
  // Denormaliserat på leadet, inte uträknat vid läsning: "nästa lead att
  // ringa" måste kunna besvaras med ett indexerat villkor, inte en aggregering.
  nextActionAt   DateTime? // tidigast ringbar igen (vila mellan försök)
  nextSlotId     String? // vilket ringpass som står på tur
  attemptCount   Int       @default(0) // mot taket i DialerConfig
  noAnswerStreak Int       @default(0) // nollställs så fort någon svarar
  triedSlotsJson String    @default("[]") // pass som redan prövats detta varv
  lastAttemptAt  DateTime?
  lastResult     CallResult?
  /// Utfallet på senaste samtalet, speglat hit av samma skäl som `lastResult`:
  /// vilan ska gå att räkna om utan att slå i CallAttempt-historiken, och
  /// däcket ska kunna varna för ett nej utan en join per rad.
  lastOutcome    ConversationOutcome?
  lastNoReason   NoReason?
  callbackAt     DateTime? // bokad återuppringning — vinner alltid över rotationen

  // Kort arbetslås (minuter), till skillnad från claim-låset (60 dygn).
  // Hindrar att två säljare får samma lead i cockpit samtidigt.
  leasedById   String?
  leasedUntil  DateTime?

  retired       Boolean @default(false) // uttömd, spärrad eller vunnen
  retiredReason String?

  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  contacts     Contact[]
  activities   Activity[]
  deals        Deal[]
  tags         TagOnLead[]
  lists        LeadOnList[]
  callAttempts CallAttempt[]
  dossier      LeadDossier?
  gatekeepers  GatekeeperContact[]
  dnc          DoNotCall?
  callbacks    Callback[]
  telephonyCalls TelephonyCall[]

  @@index([claimedAt])
  @@index([ownerId])
  @@index([hasActiveDeal, updatedAt])
  @@index([retired, nextActionAt])
  @@index([leasedUntil])
  @@index([callbackAt])
  @@index([industry])
}

model Contact {
  id          String   @id @default(cuid())
  /// Visningsnamnet — alltid ifyllt. Sätts ihop av firstName + lastName när
  /// filen har dem i var sin kolumn, annars tas det rakt av från en namnkolumn.
  name        String
  /// Separata delar när importfilen har dem. Behövs för tilltalsnamn i manus:
  /// "Hej Anders" kräver förnamnet, och att splitta name på mellanslag ger fel
  /// så fort någon heter "Anna Maria" eller "von Sydow".
  firstName   String?
  lastName    String?
  role        String?
  directPhone String?
  switchboard String?
  email       String?
  linkedin    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Normaliserade nummer. Fälten ovan är fritext från CSV-import och går inte
  // att matcha mot ett inkommande samtal — utan de här är callback-fångst
  // (Modul 4) omöjlig, oavsett vilken växel som används.
  directPhoneE164 String?
  switchboardE164 String?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  activities   Activity[]
  callAttempts CallAttempt[]
  callbacks    Callback[]
  telephonyCalls TelephonyCall[]

  @@index([leadId])
  @@index([directPhoneE164])
  @@index([switchboardE164])
}

// ==================== ÅTERKOMSTER ====================

/// En lovad återuppringning, som en egen rad och inte bara en tidsstämpel på
/// leadet.
///
/// `Lead.callbackAt` finns kvar och skrivs fortfarande — uppföljningsmotorn
/// och lease-frågan läser den, och den ska förbli en indexerad kolumn på
/// leadet. Men den kan bara bära EN återkomst och glömmer den så fort nästa
/// bokas. Det gör tre saker omöjliga, och alla tre behövs för att en
/// påminnelse ska vara värd namnet:
///
///  1. Att veta om en återkomst faktiskt ringdes upp eller missades. Utan
///     status finns ingen skillnad mellan "ringde 14:02 som lovat" och
///     "glömde bort den i tre veckor".
///  2. Att skicka en påminnelse till RÄTT person. `Lead.ownerId` byter ägare
///     vid varje disposition; den som lovade att ringa är inte nödvändigtvis
///     den som står som ägare när påminnelsen ska gå.
///  3. Att mäta något. `CallAttempt` är append-only och vet att en återkomst
///     bokades, men inte om löftet hölls.
///
/// Missad är MEDVETET inget lagrat status: det är `PENDING` med en tid som
/// passerat. Ett lagrat värde hade krävt ett jobb som vänder rader vid rätt
/// minut, och den minuten hade blivit fel varje gång jobbet inte kördes.
model Callback {
  id String @id @default(cuid())

  /// Exakt tidpunkt säljaren lovade. Aldrig justerad mot ringpass eller
  /// spärrade datum — kunden sa "ring på torsdag efter fem", och det löftet
  /// väger tyngre än rotationen.
  scheduledAt DateTime
  /// Vad som ska sägas när man ringer. Fritext, syns i notisen och i mejlet.
  note String?
  /// Säljarens kryss i bokningsrutan. Styr om raden tas med i morgonmejlet —
  /// och det är den ENDA vägen in i ett mejl. Urbockat som förval: en påminnelse
  /// som kommer på allt är samma sak som ingen påminnelse alls, och krysset ska
  /// betyda "den här får jag inte missa".
  emailReminder Boolean @default(false)

  status CallbackStatus @default(PENDING)

  /// Sätts när morgonmejlet gått. Är samma som skyddet mot dubbelutskick:
  /// ett jobb som körs två gånger samma dag mejlar inte om raden.
  emailSentAt  DateTime?
  /// Kvitterad i klockan. Nollställer räknaren utan att avboka något.
  seenAt       DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Den som lovade att ringa — inte leadets ägare, se ovan.
  sellerId String
  seller   User   @relation("CallbackSeller", fields: [sellerId], references: [id])

  /// Samtalen den bokades i respektive stängdes av. Ingen relation, bara id:n:
  /// CallAttempt är append-only och ska inte kunna kaskadradera en återkomst.
  bookedOnAttemptId    String?
  completedOnAttemptId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Klockan frågar "mina öppna, i tidsordning" varje minut. Det är den
  /// frågan indexet finns för.
  @@index([sellerId, status, scheduledAt])
  /// Chefsvyn och morgonjobbet frågar över hela golvet.
  @@index([status, scheduledAt])
  @@index([leadId, status])
  /// Reservationen i leaseNextLeads: "har det här leadet en öppen återkomst som
  /// tillhör NÅGON ANNAN än den som leasar?". Ett villkor per lead-kandidat i
  /// appens hetaste fråga.
  @@index([leadId, status, sellerId])
}

enum CallbackStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// ==================== RINGLISTOR (mappar) ====================

/// En mapp med leads — skapas normalt av en import, men kan också vara manuell.
/// Åtkomst styrs av ListAccess; admin ser alla.
model CallList {
  id          String   @id @default(cuid())
  name        String
  description String?
  sourceFile  String?
  /// Systemmappar (t.ex. "Tidigare importer") kan inte tas bort
  isSystem    Boolean  @default(false)
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation("ListCreatedBy", fields: [createdById], references: [id])

  leads        LeadOnList[]
  access       ListAccess[]
  callAttempts CallAttempt[]
  scripts      ScriptTemplate[]

  @@index([archived, createdAt])
  @@index([createdById])
}

/// Ett lead kan ligga i flera mappar samtidigt — samma bolag som dyker upp i
/// två importer blir EN lead-rad som länkas in i båda mapparna.
model LeadOnList {
  listId  String
  leadId  String
  addedAt DateTime @default(now())

  /// True när det var DEN HÄR länken som skapade leadet — importen hittade
  /// inget befintligt bolag på org-numret. False när leadet redan fanns och
  /// bara länkades in (dubbletten).
  ///
  /// Avgör vad som händer när mappen tas bort: leads som mappen skapade följer
  /// med, dubbletter blir kvar. Utan flaggan går de två fallen inte att skilja
  /// åt i efterhand — createdAt duger inte, eftersom ett lead som importerades
  /// och återimporterades samma dag ser likadant ut som ett nyskapat.
  createdByImport Boolean @default(false)

  list CallList @relation(fields: [listId], references: [id], onDelete: Cascade)
  lead Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([listId, leadId])
  @@index([leadId])
  @@index([listId, createdByImport])
}

/// Ger en användare tillgång till en mapp. Admin behöver ingen rad — ser allt.
model ListAccess {
  listId    String
  userId    String
  grantedAt DateTime @default(now())

  list CallList @relation(fields: [listId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([listId, userId])
  @@index([userId])
}

// ==================== AFFÄRER ====================

/// En affär är ett avslut, inte en prognos.
///
/// Verksamheten är one call close: det finns ingen väg från "intresserad" till
/// "kund" som går via ett möte, en demo och en offert. Antingen såldes det i
/// samtalet eller inte. Pipeline-steg, sannolikhet och förväntat avslutsdatum
/// togs därför bort i migration 015 — de beskrev ett arbetssätt som aldrig
/// användes, och tre av fyra fält i registreringsrutan bar dem.
///
/// Raden skapas i samma ögonblick som säljaren dispositionerar "Såld", och
/// bär det som behövs för att någon annan ska kunna ta över kunden: vem man
/// pratade med, vad de betalar och vad som sades. Historiken — samtalen och
/// anteckningarna före avslutet — ligger kvar på leadet och hämtas därifrån.
model Deal {
  id           String     @id @default(cuid())
  title        String
  /// Personen som sa ja. Kopieras hit i stället för att pekas ut med en
  /// `contactId`: kontakten kan tas bort eller bytas ut på leadet, men vem
  /// som skrev på ska stå kvar precis som det stod när affären gjordes.
  contactName  String?
  contactEmail String?
  contactPhone String?
  /// Ett belopp, inte två. `valueType` säger om det är ett engångsbelopp
  /// eller en månadskostnad — ett avtal är aldrig både och, och två kolumner
  /// där bara en får vara ifylld är en bugg som väntar.
  valueType    ValueType  @default(ONE_TIME)
  value        Float?
  notes        String?
  /// WON är förvalet eftersom raden bara skapas när affären redan är gjord.
  /// LOST betyder ångrad/avbokad i efterhand, inte "förlorad i pipelinen".
  status       DealStatus @default(WON)
  /// När affären gjordes. Separat från `createdAt` så att en affär som
  /// registreras i efterhand kan dateras till dagen den faktiskt stängdes —
  /// statistiken frågar efter säljdatum, inte efter när någon hann fylla i.
  closedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  leadId      String
  lead        Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User          @relation("DealCreatedBy", fields: [createdById], references: [id])

  products    DealProduct[]

  @@index([leadId])
  @@index([status, closedAt])
  @@index([createdById])
}

enum DealStatus {
  WON
  LOST
}

enum ValueType {
  ONE_TIME
  MONTHLY
}

// ==================== PRODUCTS ====================

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Float?
  isRecurring Boolean  @default(false)
  unit        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  dealProducts DealProduct[]
}

model DealProduct {
  id          String   @id @default(cuid())
  name        String
  price       Float?
  quantity    Int      @default(1)
  isRecurring Boolean  @default(false)
  unit        String?

  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@index([dealId])
  @@index([productId])
}

// ==================== ACTIVITY LOG ====================

model Activity {
  id        String       @id @default(cuid())
  type      ActivityType
  timestamp DateTime     @default(now())
  metadata  String?      // JSON string: { note, status, from, to, etc. }

  actorId String
  actor   User   @relation("ActivityActor", fields: [actorId], references: [id])

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id])

  @@index([leadId, timestamp])
  @@index([actorId, timestamp])
  @@index([contactId])
}

enum ActivityType {
  CALL
  CALL_NO_ANSWER
  NOTE
  STAGE_CHANGE
  LEAD_CREATED
  LEAD_ASSIGNED
  LEAD_IMPORTED
  LEAD_CLAIMED
  LEAD_RELEASED
  /// Bolaget låg i en säljares cockpit-kö när en kollega tog över arbetslåset.
  /// Skrivs av `renewLeases` och bara när någon ANNAN håller leasen — ett
  /// släppt eget lås är ingen krock. Mätpunkten för om två säljare fortfarande
  /// hamnar på samma bolag; se docs/ARBETSLOGG.md 2026-08-17.
  LEAD_LEASE_LOST
  CONTACT_ADDED
  STATUS_CHANGE
  DEAL_CREATED
  /// Skrivs inte längre — pipelinen togs bort i migration 015. Värdet står
  /// kvar för att gamla rader ska gå att läsa: aktivitetsloggen är
  /// oföränderlig, och Prisma kastar på ett enumvärde den inte känner igen.
  DEAL_STAGE_CHANGE
  DEAL_WON
  DEAL_LOST
}

// ==================== CALL SESSIONS (Fluff-tracking) ====================

model CallSession {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  totalCalls Int       @default(0)
  totalIdle  Int       @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  events   CallEvent[]
  attempts CallAttempt[]

  @@index([userId, startedAt])
}

model CallEvent {
  id            String    @id @default(cuid())
  callStartedAt DateTime
  callEndedAt   DateTime?
  idleBefore    Int       @default(0)

  sessionId String
  session   CallSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ==================== UPPFÖLJNINGSMOTOR (Modul 4) ====================

/// Vad som hände med SAMTALET. Sätts av telefonin där sådan finns, annars av
/// säljaren. Driver retry-logiken.
enum CallResult {
  NO_ANSWER
  BUSY
  VOICEMAIL_LEFT
  VOICEMAIL_NO_MESSAGE
  WRONG_NUMBER
  INVALID_NUMBER
  CONNECTED_GATEKEEPER
  CONNECTED_DM
}

/// Vad som hände i SAMTALET. Sätts bara när någon faktiskt svarade.
/// Två fält i stället för ett är hela poängen: "nådde ej DM" är ett
/// samtalsresultat, "DM sa nej" är ett samtalsutfall. Slås de ihop går
/// svarsfrekvensen inte längre att räkna, och "ej intresserad" blir återigen
/// soptunnan som döljer allt.
enum ConversationOutcome {
  GATEKEEPER_BLOCKED
  GATEKEEPER_TRANSFERRED
  GATEKEEPER_GAVE_DM_DETAILS
  /// Någon svarade och pratade, men var inte den som bestämmer. Skilt från
  /// DM_NO: det här är inget nej på erbjudandet, för erbjudandet nådde aldrig
  /// rätt person. Räknas de ihop ser ett lead med fel kontaktuppgift ut som
  /// ett lead som tackat nej, och bolaget dör i statistiken utan att någon
  /// någonsin ställt frågan till rätt person.
  WRONG_DM
  DM_NO
  CALLBACK_BOOKED
  SOLD
}

/// Andra nivån, bara på DM_NO. Ett tryck, ingen rullgardin — mer än sex
/// alternativ och träffsäkerheten kollapsar.
enum NoReason {
  PRIS
  TIMING
  HAR_BYRA
  HAR_INHOUSE
  INGET_BEHOV
  NOJD_MED_ANNAN
  /// Nejet kom innan pitchen hann fram — alltså inget svar på erbjudandet,
  /// utan ett reflexnej på att bli uppringd. Egen kategori eftersom det mäter
  /// öppningen, inte produkten: en säljare med många av dessa har ett
  /// intro-problem, inte ett pris- eller behovsproblem.
  NEJ_INNAN_PITCH
  /// Principiellt nej till kalla samtal, oavsett vad som erbjuds. Skilt från
  /// NEJ_INNAN_PITCH, som är en tidpunkt: det här är en hållning, och den
  /// ändras inte av ett bättre intro. Ett lead med många av dessa är en
  /// kandidat för spärrlistan, inte för nästa varv i rotationen.
  VILL_EJ_PRATA_SALJARE
}

enum CallDirection {
  OUTBOUND
  INBOUND
}

/// Ramverket: Växel → Intro → Presentation → Behovsanalys → ROI → COI →
/// Avslut ⇄ Invändningshantering. Invändning är ett sidoläge man återvänder
/// från, inte ett steg framåt — men samtalet kan dö där, så det är ett värde.
enum FrameworkStep {
  VAXEL
  INTRO
  PRESENTATION
  BEHOVSANALYS
  ROI
  COI
  AVSLUT
  INVANDNING
}

/// Faktatabellen. Append-only — rader uppdateras aldrig, raderas aldrig.
/// All statistik i chefsvyn läses härifrån.
model CallAttempt {
  id String @id @default(cuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  sellerId String
  seller   User   @relation("CallAttemptSeller", fields: [sellerId], references: [id])

  /// Denormaliserat: statistik per ringlista utan join.
  listId String?
  list   CallList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  sessionId String?
  session   CallSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  attemptNo Int // löpnummer per lead
  slotId    String? // vilket ringpass försöket gjordes i
  slot      CallSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  hourOfDay Int // 0–23, sparas separat så statistiken överlever att pass ändras
  weekday   Int // 1–7, måndag = 1

  direction CallDirection @default(OUTBOUND)

  // De två fälten. outcome är null när ingen svarade — det är korrekt, inte
  // saknad data, och är exakt vad svarsfrekvensens nämnare bygger på.
  result   CallResult
  outcome  ConversationOutcome?
  noReason NoReason?

  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  durationSec   Int       @default(0)
  idleBeforeSec Int       @default(0)

  note String?

  /// Idempotensnyckel för telefoni-webhooks. Samma händelse levereras om.
  providerCallId String? @unique
  recordingUrl   String?
  dialedE164     String?

  /// Vilken manusversion säljaren faktiskt hade på skärmen. Utan den blir
  /// A/B-testet meningslöst så fort ett manus redigeras.
  scriptVersionId String?
  scriptVersion   ScriptVersion? @relation(fields: [scriptVersionId], references: [id], onDelete: SetNull)

  progress CallFrameworkProgress?
  telephonyCalls TelephonyCall[]

  @@index([leadId, startedAt])
  @@index([sellerId, startedAt])
  @@index([startedAt])
  @@index([result, startedAt])
  @@index([outcome, startedAt])
  @@index([listId, startedAt])
  @@index([attemptNo, result])
  @@index([scriptVersionId])
  @@index([contactId])
  @@index([slotId])
}

/// Ringpass — konfigurerbara i admin. Egen tabell i stället för hårdkodad enum
/// eftersom passen ska gå att flytta när egen statistik visar vad som fungerar.
model CallSlot {
  id          String  @id @default(cuid())
  name        String // "Tidigt", "Förmiddag", ...
  startMinute Int // minuter efter midnatt, 465 = 07:45
  endMinute   Int
  order       Int
  active      Boolean @default(true)

  attempts CallAttempt[]

  @@index([active, order])
}

/// Singleton. Uppföljningsmotorns reglage, delade av hela teamet — därför i
/// databasen och inte i localStorage som övriga inställningar.
model DialerConfig {
  id String @id @default("singleton")

  maxAttempts   Int @default(8) // taket innan leadet vilar
  cooldownDays  Int @default(30) // vila efter uttömda försök
  leaseMinutes  Int @default(15) // hur länge cockpit håller ett lead
  leaseBlockSize Int @default(25) // antal leads en säljare hämtar åt gången

  // Timmar mellan försök per resultat. Ett upptaget nummer ringer man om
  // snart; en gatekeeper som blockat är inte mer mottaglig imorgon.
  retryHoursNoAnswer  Int @default(20)
  retryHoursBusy      Int @default(2)
  retryHoursVoicemail Int @default(44)
  retryHoursGatekeeper Int @default(68)

  /// Vila i DAGAR efter "vill inte prata med säljare". I dagar och inte timmar
  /// eftersom det inte är en rotationspaus utan en helt annan tidsskala: en
  /// hållning ändras inte till nästa förmiddagspass. Leadet spärras inte —
  /// bolaget kan ha bytt person, och en permanent spärr på en åsikt någon
  /// uttryckte en gång kostar mer än den skyddar.
  retryDaysNoSalespeople Int @default(30)

  /// Vila i DAGAR efter ett nej ("Sa nej"), oavsett vilken av de åtta
  /// anledningarna säljaren väljer efteråt. Utfallet bestämmer vilan;
  /// anledningen är statistik. Fram till 2026-08-28 fanns inte den här
  /// inställningen, och ett nej ärvde då `retryHoursNoAnswer` — 20 timmar.
  /// Kunden ringdes alltså igen dagen efter att hon tackat nej, av vem som
  /// helst på golvet. Se `computeNext` steg 4 i scheduler.ts.
  retryDaysNo Int @default(60)

  /// Antal samtal per timme som räknas som normal takt. Driver insatslarmen
  /// i chefsvyn — aldrig försäljningssiffror, som är brus på timnivå.
  targetCallsPerHour Int @default(22)
  idleAlertMinutes   Int @default(25)

  /// Datum som aldrig ska ringas: röda dagar, klämdagar, mellandagarna.
  /// JSON-array med "YYYY-MM-DD".
  blockedDatesJson String @default("[]")

  updatedAt DateTime @updatedAt
}

/// Spärrlista. Egen tabell och nycklad på NUMRET, inte en flagga på leadet —
/// spärren måste överleva att leadet raderas eller importeras på nytt.
model DoNotCall {
  id        String  @id @default(cuid())
  phoneE164 String  @unique
  leadId    String? @unique
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  orgNumber String?
  source    DncSource
  reason    String?

  addedById String?
  addedBy   User?   @relation("DncAddedBy", fields: [addedById], references: [id])

  expiresAt DateTime? // null = permanent
  createdAt DateTime  @default(now())

  @@index([orgNumber])
  @@index([expiresAt])
}

enum DncSource {
  PROSPECT_REQUEST
  NIX
  MANUAL
  IMPORT
  BOUNCE
}

// ==================== VÄXELHANTERING ====================

enum GatekeeperType {
  RECEPTION
  ASSISTANT
  IVR
  COLLEAGUE
  UNKNOWN
}

/// Den som svarar i växeln. Egen rad per person i stället för fritext, annars
/// får man sex stavningar av "Anna i receptionen" och ingen statistik alls.
model GatekeeperContact {
  id     String @id @default(cuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  name      String?
  role      String?
  type      GatekeeperType @default(RECEPTION)
  phoneE164 String?

  encounters Int @default(0)
  passes     Int @default(0)

  lastTacticKey    String? // "namedrop", "kort_arende", "tillbakaring", "fraga_direktnummer"
  lastTacticWorked Boolean?
  lastEncounterAt  DateTime?
  lastSaid         String? // vad som faktiskt sades — nästa säljare läser det

  // Växeln är en gratis schemaläggare: "han är tillbaka på torsdag" ska styra
  // nästa ringtid, inte bara ligga som en anteckning ingen läser.
  dmName         String?
  dmTitle        String?
  dmDirectE164   String?
  dmMobileE164   String?
  dmAvailableAt  DateTime?
  dmAvailability String?

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([phoneE164])
  @@index([dmAvailableAt])
}

// ==================== SAMTALSRAMVERK (coachningsdata) ====================

/// Fylls av ETT tryck efter samtalet, inte av avbockning under det. Att klicka
/// mitt i ett samtal stjäl uppmärksamhet i just de sekunder som avgör det, och
/// blir i praktiken ifyllt efteråt ändå — fast då som gissningar.
model CallFrameworkProgress {
  id            String      @id @default(cuid())
  callAttemptId String      @unique
  callAttempt   CallAttempt @relation(fields: [callAttemptId], references: [id], onDelete: Cascade)

  /// Denormaliserat så chefsvyn slipper join för sin vanligaste fråga.
  leadId   String
  sellerId String

  furthestStep FrameworkStep @default(VAXEL)
  endedAtStep  FrameworkStep @default(VAXEL)

  /// Hur många gånger säljaren faktiskt BAD om affären. Den här siffran är
  /// hela poängen: en säljare som frågar en gång och lägger på ser identisk ut
  /// mot en som frågade tre gånger, om man bara mäter hur långt samtalet kom.
  closeAttempts Int     @default(0)
  closedWon     Boolean @default(false)

  objectionCount    Int @default(0)
  objectionsHandled Int @default(0)

  createdAt DateTime @default(now())

  objections CallObjection[]

  @@index([sellerId, createdAt])
  @@index([leadId])
  @@index([furthestStep])
  @@index([endedAtStep])
}

/// Egen tabell, inte en JSON-array: invändningstaggar är precis vad chefsvyn
/// grupperar på, och JSON i en textkolumn går inte att gruppera på i SQLite.
model CallObjection {
  id         String                @id @default(cuid())
  progressId String
  progress   CallFrameworkProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  tag      String // "pris", "har_redan_leverantor", "ingen_tid", "skicka_mail", ...
  atStep   FrameworkStep
  handled  Boolean @default(false)
  quote    String?
  sequence Int     @default(0)

  @@index([progressId])
  @@index([tag, handled])
}

// ==================== MANUS (Modul 3) ====================

/// Ett manus per steg i ramverket. Skrivs av chefen, aldrig av en modell.
model ScriptTemplate {
  id     String        @id @default(cuid())
  name   String
  step   FrameworkStep
  active Boolean       @default(true)

  /// NULL = manuset gäller alla mappar. Satt = manuset gäller BARA den mappen
  /// och ersätter det allmänna manuset för samma steg när säljaren ringer där.
  ///
  /// En mapp med bygg-leads och en med redovisningsbyråer öppnas inte likadant,
  /// och alternativet — att skriva om det allmänna manuset inför varje kampanj —
  /// river sönder statistiken varje gång.
  ///
  /// SetNull och inte Cascade: en publicerad version kan ligga på hundratals
  /// CallAttempt-rader, och kaskaden hade tagit bort texten statistiken pekar
  /// på. `deleteList` inaktiverar mappens manus innan mappen försvinner, så ett
  /// manus som blir mappfritt här är redan avstängt och kan aldrig råka bli
  /// allmänt.
  listId String?
  list   CallList? @relation(fields: [listId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation("ScriptAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  versions ScriptVersion[]

  @@index([step, active])
  @@index([listId, step, active])
}

/// Oföränderlig när den publicerats — en redigering skapar en ny version.
/// Utan det pekar gammal statistik på text som inte längre finns.
model ScriptVersion {
  id         String         @id @default(cuid())
  templateId String
  template   ScriptTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  version     Int
  publishedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  variants ScriptVariant[]
  attempts CallAttempt[]

  @@unique([templateId, version])
  @@index([templateId, publishedAt])
}

/// Prioritetsordnad variant. Första vars datakrav är uppfyllda renderas — så
/// att en säljare aldrig får en mening med ett tomt hål i.
model ScriptVariant {
  id        String        @id @default(cuid())
  versionId String
  version   ScriptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  label String

  /// Lägst tal vinner. Sista varianten bör ha tomma krav och fungerar då alltid.
  priority Int @default(100)

  /// Texten med platshållare: "Ni ligger på plats {seo.rank} på {seo.keyword}."
  /// Platshållarnamnen är LeadClaim.key.
  body String

  /// JSON-array med de claim-nycklar som MÅSTE finnas. Tom array = fallback.
  requiredKeysJson String @default("[]")

  /// Lägsta konfidens på varje krävd nyckel. Under tröskeln hoppas varianten
  /// över helt — hellre färre påståenden än ett osäkert.
  minConfidence Int @default(50)

  @@index([versionId, priority])
}

// ==================== PITCH-MOTORN (Modul 2) ====================

enum DossierStatus {
  PENDING
  OK
  PARTIAL
  FAILED
  STALE
}

/// Ett förberäknat underlag per lead. Läses med EN primärnyckelsökning när
/// samtalet kopplas — aldrig beräknat vid rendering, aldrig ett API-anrop.
model LeadDossier {
  leadId String @id
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  weaknessCount     Int           @default(0)
  overallConfidence Int           @default(0)
  status            DossierStatus @default(PENDING)

  fetchedAt    DateTime?
  staleAfter   DateTime?
  errorMessage String?

  claims LeadClaim[]

  @@index([status, staleAfter])
  @@index([weaknessCount])
}

/// EN uppgift, med egen källa, egen konfidens och egen färskhet.
/// Saknad rad betyder OKÄNT — vilket är något helt annat än värdet noll.
/// Därför EAV och inte en bred tabell med nullbara kolumner.
model LeadClaim {
  id      String      @id @default(cuid())
  leadId  String
  dossier LeadDossier @relation(fields: [leadId], references: [leadId], onDelete: Cascade)

  /// "seo.rank", "seo.keyword", "seo.competitor", "gmb.reviewCount",
  /// "gmb.newestReview", "pagespeed.mobileLcp", "tech.hasSSL",
  /// "tech.mobileFriendly", "tech.title", "tech.copyrightYear"
  key String

  // Typade kolumner så chefsvyn kan sortera och medelvärdesberäkna utan cast.
  valueNum  Float?
  valueStr  String?
  valueBool Boolean?
  unit      String? // "ms", "position", "st", "score"

  confidence Int      @default(50)

  /// Säljstyrka 1–5 — en annan sak än säkerhet. Att sakna schema.org-markup
  /// är nästan alltid sant (hög säkerhet) och nästan aldrig intressant för en
  /// rörmokare (låg styrka). Utan den här skillnaden sorteras panelen på
  /// förekomst, och då hamnar de tråkigaste punkterna överst på varje samtal.
  strength   Int      @default(3)

  /// True när uppgiften är en säljbar brist, inte bara ett faktum.
  weakness   Boolean  @default(false)

  source     String // vilken tjänst uppgiften kom från
  sourceUrl  String? // belägg säljaren kan öppna mitt i samtalet
  fetchedAt  DateTime @default(now())

  /// Rådata för felsökning. Får aldrig ingå i cockpitens select.
  rawJson String?

  @@unique([leadId, key])
  @@index([key])
}

// ==================== NÄRVARO (Modul 5) ====================

enum PresenceStatus {
  OFFLINE
  IDLE
  DIALING
  ON_CALL
  WRAP_UP
  BREAK
}

/// En rad per säljare, alltid upsert. Räknarna hålls här i stället för att
/// aggregeras fram — chefsvyn ska aldrig scanna faktatabellen för att rita
/// en siffra som uppdateras varje minut.
model SellerPresence {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status PresenceStatus @default(OFFLINE)

  currentLeadId   String?
  currentCompany  String? // denormaliserat — inga joins i live-vyn
  currentListId   String?
  currentListName String?
  callStartedAt   DateTime? // klienten räknar upp härifrån
  sessionId       String?

  todayCalls    Int @default(0)
  todaySold     Int @default(0)
  todayTalkSec  Int @default(0)

  /// "2026-08-05" — räknarna nollställs när datumet inte stämmer, så inget
  /// nattligt cron-jobb behövs.
  countersDate String @default("")

  lastHeartbeat DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([lastHeartbeat])
}

// ==================== TAGS ====================

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("#6B7280")

  leads TagOnLead[]
}

model TagOnLead {
  leadId String
  tagId  String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
  @@index([tagId])
}

// ==================== TELEFONI (Lynes) ====================
//
// Se prisma/migrations/017_lynes_telefoni.sql för hela motiveringen. Kort:
// Lynes webhook-format är inte publikt dokumenterat, så mottagningen sparar
// rådata separat från sin egen tolkning av det.

/// Rå, oförändrad kopia av varje accepterad leverans. Append-only.
///
/// Finns för att tolkningen är en gissning tills första riktiga payloaden
/// setts. Den här tabellen är facit man rättar gissningen mot — och den enda
/// anledningen till att en feltolkning inte innebär förlorad data.
model TelephonyEvent {
  id       String @id @default(cuid())
  provider String @default("lynes")

  /// Providerns leverans-id. Gör mottagningen idempotent: en växel levererar
  /// om vid timeout. NULL får förekomma flera gånger — SQLite räknar NULL som
  /// skilda värden i ett unikt index, vilket är precis vad som behövs här.
  providerEventId String?

  /// Rått och oöversatt. Att mappa in i en enum innan värdemängden är känd
  /// hade kastat bort just det som behövs för att skriva mappningen.
  eventType String?
  callId    String?

  /// Vilken nyckelplacering som matchade: bearer, header-secret, hmac-sha256
  /// eller query-param. Enda sättet att se hur Lynes faktiskt autentiserar
  /// sig, så att de övriga kan stängas av sedan.
  authMethod String

  handled    Boolean  @default(false)
  error      String?
  rawJson    String
  receivedAt DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@index([callId])
  @@index([handled, receivedAt])
}

/// Växelns användare, mappad mot vår.
///
/// Skapas automatiskt med userId = NULL första gången en okänd anknytning
/// ringer. En synlig okopplad rad är oändligt mycket bättre än ett tyst
/// bortkastat samtal, och eftersom TelephonyCall pekar på agenten följer hela
/// historiken med i samma sekund som kopplingen görs.
model TelephonyAgent {
  id       String @id @default(cuid())
  provider String @default("lynes")

  /// Bästa stabila identifierare i payloaden, i fallande ordning: växelns
  /// användar-id, anknytning, e-post, namn.
  externalId String

  extension String?
  email     String?
  name      String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// True när kopplingen gjordes automatiskt på e-postmatchning. Endast exakt
  /// e-post matchas automatiskt — namn aldrig, eftersom fel säljare på ett
  /// samtal förgiftar både statistiken och provisionen.
  autoLinked Boolean @default(false)

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  calls TelephonyCall[]

  @@unique([provider, externalId])
  @@index([userId])
  @@index([email])
}

/// Ett samtal som växeln ser det. En rad per samtal, uppdaterad av varje
/// händelse om det.
///
/// Skild från CallAttempt med flit: CallAttempt är vad SÄLJAREN registrerade
/// och är faktatabellen statistiken läses ur. Den här är en andra, oberoende
/// observation av samma samtal — den vet ringtid, talartid och inspelning men
/// ingenting om utfallet. Slås de ihop går det inte längre att säga om en
/// siffra kom från en människa eller från växeln.
model TelephonyCall {
  id             String @id @default(cuid())
  provider       String @default("lynes")
  providerCallId String

  direction String?
  /// Härledd: RINGING, ANSWERED, COMPLETED, NO_ANSWER, BUSY, FAILED,
  /// VOICEMAIL, UNKNOWN. Rå eventtyp sparas i lastEventType vid sidan om.
  status        String  @default("UNKNOWN")
  lastEventType String?

  /// Både rått och normaliserat. E.164 är det som går att matcha på,
  /// råversionen det som går att felsöka med när normaliseringen returnerar
  /// null — vilket den gör hellre än att gissa.
  fromRaw  String?
  toRaw    String?
  fromE164 String?
  toE164   String?

  /// to vid utgående, from vid inkommande. Denormaliserad eftersom varje
  /// uppslag mot lead frågar efter just den, och ett CASE i WHERE gör
  /// indexet oanvändbart.
  otherPartyE164 String?

  startedAt  DateTime?
  answeredAt DateTime?
  endedAt    DateTime?

  /// durationSec är hela samtalet inklusive ringtid, talkSec bara den
  /// uppkopplade delen. Skilda för att 40 sekunders ringsignal inte är 40
  /// sekunders samtal.
  durationSec Int?
  talkSec     Int?
  waitSec     Int?

  hangupCause String?
  queueName   String?

  /// Pekar med största sannolikhet in i Lynes och kräver inloggning där.
  /// Sparas ändå — en länk en admin kan öppna är värd mer än ingen.
  recordingUrl String?
  recordingId  String?

  agentId String?
  agent   TelephonyAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// Säljarens egen registrering av samma samtal, när den gick att hitta.
  callAttemptId String?
  callAttempt   CallAttempt? @relation(fields: [callAttemptId], references: [id], onDelete: SetNull)

  eventCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([provider, providerCallId])
  @@index([userId, startedAt])
  @@index([startedAt])
  @@index([leadId, startedAt])
  @@index([agentId])
  @@index([callAttemptId])
  @@index([otherPartyE164, startedAt])
}
