{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // scripts/ körs av node --experimental-strip-types, som KRÄVER .ts i
  // importsökvägen — det motsatta av vad bundler-upplösningen tillåter.
  // De verifieras genom att köras (npm test), inte av tsc.
  "exclude": ["node_modules", "scripts"]
}
