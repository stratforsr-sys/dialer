# ── Databas ────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://xxxxx.turso.io
TURSO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Autentisering ──────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer-token som Vercel Cron autentiserar sig med.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Pitch-motorn (Modul 2) ─────────────────────────────────────────────────

# PageSpeed Insights. GRATIS, men krävs i praktiken: utan nyckel delar man en
# liten anonym dygnskvot med alla andra som anropar från samma nät, och den är
# i regel redan förbrukad (HTTP 429). Nyckeln kräver ingen betalningsuppgift.
#   console.cloud.google.com → APIs & Services → aktivera "PageSpeed Insights API"
#   → Credentials → Create credentials → API key
# Utan den här är hastighetsspåret avstängt; övriga gratiskontroller körs ändå.
PAGESPEED_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rankspåret — AVSTÄNGT tills nyckeln sätts.
# Ger rankposition (sidvis djup, alltså exakt plats även på sida 5), sökordet,
# konkurrenten som ligger etta, samt betyg, recensionsantal och kategori från
# Google-profilen. Gratisnyckel utan kreditkort: serper.dev → 2 500 krediter.
#
# Krediterna är ENGÅNGS, inte per månad. Kör alltid torrkörningen först:
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#     "https://dialer-five.vercel.app/api/cron/seo?dry=1"
#
# Ett anrop per bransch+ort täcker hela segmentet — alla rörmokare i Malmö
# konkurrerar om samma sökning, så positionen läses ur ett gemensamt svar.
# Utan detta finns ingen rankposition alls: att skrapa google.se själva ger
# CAPTCHA inom minuter och en siffra som ibland är fel — och en säljare som
# har fel en gång slutar lita på verktyget.
# SERPER_KEY=
# Tak per körning. Default 200, alltså cirka 33 sökord åt gången i värsta fall.
# SERPER_CREDIT_BUDGET=200
# Sidor per sökord, 1-10. Default 5 (femtio träffar). OBS: Serper ignorerar
# num-parametern — djup får man bara via page, en kredit per sida.
# SERPER_MAX_PAGES=5

# ── Research (befintlig battle card-funktion) ──────────────────────────────
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Påminnelser via e-post ─────────────────────────────────────────────────

# Resend. Utan nyckel är utskicken AVSTÄNGDA — jobbet svarar "skipped" i
# stället för att fela, och allt annat i återkomsterna fungerar ändå.
#   resend.com → API Keys → Create API Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Avsändare. Domänen MÅSTE vara verifierad i Resend (DNS: SPF + DKIM), annars
# svarar API:et 403 på varje utskick. Utan egen domän kan man testa mot
# onboarding@resend.dev, men bara till sin egen inloggningsadress.
# Både "noreply@clicknet.se" och "Sales Hub <noreply@clicknet.se>" fungerar.
EMAIL_FROM=Sales Hub <noreply@clicknet.se>

# Bas-URL i mejlens länkar. Faller tillbaka på NEXTAUTH_URL och därefter
# produktionsadressen — sätts bara om de två pekar fel.
# APP_URL=https://dialer-five.vercel.app

# ── Telefoni: Lynes webhook ────────────────────────────────────────────────

# Delad hemlighet för inkommande samtalshändelser från Lynes växel.
# Generera en ny med:  openssl rand -hex 32
#
# Samma värde ska stå i Lynes webhook-inställning. Mottagningen accepterar
# nyckeln på fyra sätt eftersom Lynes inte dokumenterar vilket den använder:
# Authorization-bearer, egen header (X-Api-Key m.fl.), HMAC-SHA256 över rå
# body, eller ?secret= i URL:en. Vilket som matchade skrivs i
# TelephonyEvent.authMethod — läs den efter första riktiga leveransen och
# stryp sedan listan i src/lib/telephony/verify.ts till det enda som används.
#
# Utan nyckeln avvisas ALLA leveranser med 401. Det finns med flit ingen
# "ingen nyckel satt = släpp igenom"-väg.
LYNES_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
