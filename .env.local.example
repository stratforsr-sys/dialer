# ── Databas ────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://xxxxx.turso.io
TURSO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxx

# ── Autentisering ──────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bearer-token som Vercel Cron autentiserar sig med.
CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Pitch-motorn (Modul 2) ─────────────────────────────────────────────────

# PageSpeed Insights. GRATIS, men krävs i praktiken: utan nyckel delar man en
# liten anonym dygnskvot med alla andra som anropar från samma nät, och den är
# i regel redan förbrukad (HTTP 429). Nyckeln kräver ingen betalningsuppgift.
#   console.cloud.google.com → APIs & Services → aktivera "PageSpeed Insights API"
#   → Credentials → Create credentials → API key
# Utan den här är hastighetsspåret avstängt; övriga gratiskontroller körs ändå.
PAGESPEED_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Rankspåret — AVSTÄNGT tills nyckeln sätts.
# Ger rankposition (djup 100, alltså exakt plats även på sida 5), sökordet,
# konkurrenten som ligger etta, samt betyg, recensionsantal och kategori från
# Google-profilen. Gratisnyckel utan kreditkort: serper.dev → 2 500 krediter.
#
# Krediterna är ENGÅNGS, inte per månad. Kör alltid torrkörningen först:
#   curl -H "Authorization: Bearer $CRON_SECRET" \
#     "https://dialer-five.vercel.app/api/cron/seo?dry=1"
#
# Ett anrop per bransch+ort täcker hela segmentet — alla rörmokare i Malmö
# konkurrerar om samma sökning, så positionen läses ur ett gemensamt svar.
# Utan detta finns ingen rankposition alls: att skrapa google.se själva ger
# CAPTCHA inom minuter och en siffra som ibland är fel — och en säljare som
# har fel en gång slutar lita på verktyget.
# SERPER_KEY=
# Tak per körning. Default 200, alltså cirka 18 sökord åt gången.
# SERPER_CREDIT_BUDGET=200

# ── Research (befintlig battle card-funktion) ──────────────────────────────
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
